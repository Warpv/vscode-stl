{
  "name": "vscode-stl",
  "displayName": "vscode-stl",
  "description": "STL snippies and highlight",
  "version": "1.2.1",
  "publisher": "NIKOinc",
  "icon": "images/icon.png",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Warpv/vscode-stl.git"
  },
  "keywords": [
    "STL",
    "Statement List",
    "PLC",
    "CoDeSys"
  ],
  "activationEvents": [
    "onLanguage:stl"
  ],
  "contributes": {
    "languages": [{
      "id": "stl",
      "aliases": ["Statement List", "stl"],
      "extensions": [".stl", ".awl", ".s", ".STL", ".AWL", ".S"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "stl",
      "scopeName": "source.stl",
      "path": "./syntaxes/stl.tmLanguage.json"
    }],
    "formatting": {
      "defaultFormatter": {
        "stl": "NIKOinc.vscode-stl"
      }
    }
  },
  "devDependencies": {
    "@types/vscode": "^1.98.0",
    "@types/node": "^16.11.7",
    "vscode": "^1.1.37"
  }
}
