{
  "name": "vscode-stl",
  "displayName": "vscode-stl",
  "description": "STL snippies and highlight",
  "version": "1.2.0",
  "publisher": "NIKOinc",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
      "type": "git",
      "url": "https://github.com/Warpv/vscode-stl.git"
  },
  "keywords": [
    "STL",
    "Statement List",
    "PLC",
    "CoDeSys"
  ],
  "contributes": {
    "languages": [{
      "id": "stl",
      "aliases": ["Statement List", "stl"],
      "extensions": [".stl .awl .s .STL .AWL .S"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "stl",
      "scopeName": "source.stl",
      "path": "./syntaxes/stl.tmLanguage.json"
    }]
  }
}
